{
  "name": "crm-booking-api",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "apps/api/app.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node apps/api/server.js",
    "start:api": "node apps/api/server.js",
    "start:appointments": "node apps/appointments-service/server.js",
    "start:customers": "node apps/customers-service/server.js",
    "start:services": "node apps/services-service/server.js",
    "start:professionals": "node apps/professionals-service/server.js",
    "start:local": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config apps/api/server.js",
    "dev": "nodemon apps/api/server.js",
    "dev:api": "nodemon apps/api/server.js",
    "dev:appointments": "nodemon apps/appointments-service/server.js",
    "dev:customers": "nodemon apps/customers-service/server.js",
    "dev:services": "nodemon apps/services-service/server.js",
    "dev:professionals": "nodemon apps/professionals-service/server.js",
    "dev:local": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config ./node_modules/.bin/nodemon apps/api/server.js",
    "infra:up": "docker compose --env-file .env.local up --build",
    "infra:down": "docker compose --env-file .env.local down",
    "test": "NODE_ENV=test node --test test/integration/*.test.js test/nest/*.test.js",
    "test:integration": "NODE_ENV=test node --test test/integration/*.test.js",
    "test:nest": "NODE_ENV=test node --test test/nest/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.6.2",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^4.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.1.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}

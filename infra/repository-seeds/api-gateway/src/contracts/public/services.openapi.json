{
  "openapi": "3.1.0",
  "info": {
    "title": "Services Internal API",
    "version": "1.0.0",
    "description": "Internal HTTP contract for the services catalog service."
  },
  "servers": [
    {
      "url": "http://localhost:3003",
      "description": "Local services service"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Service health check",
        "responses": {
          "200": {
            "description": "Health status",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthStatus" }
              }
            }
          }
        }
      }
    },
    "/api/services": {
      "get": {
        "summary": "List services",
        "parameters": [
          { "$ref": "#/components/parameters/search" },
          { "$ref": "#/components/parameters/page" },
          { "$ref": "#/components/parameters/limit" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/ServicesPage" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "summary": "Create service",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateServiceRequest" }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Service" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/services/{id}": {
      "get": {
        "summary": "Get service by id",
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Service" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "summary": "Update service",
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateServiceRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Service" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "summary": "Delete service",
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "responses": {
          "204": { "description": "Service deleted" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ObjectId" }
      },
      "search": {
        "name": "search",
        "in": "query",
        "schema": { "type": "string" }
      },
      "page": {
        "name": "page",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1 }
      },
      "limit": {
        "name": "limit",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "responses": {
      "Service": {
        "description": "Service",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Service" }
          }
        }
      },
      "ServicesPage": {
        "description": "Services page",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["data"],
              "properties": {
                "data": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Service" }
                },
                "pagination": { "$ref": "#/components/schemas/Pagination" }
              }
            }
          }
        }
      },
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid internal token",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "Service not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "schemas": {
      "ObjectId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{24}$"
      },
      "Service": {
        "type": "object",
        "required": ["id", "name", "durationMinutes", "price"],
        "properties": {
          "id": { "$ref": "#/components/schemas/ObjectId" },
          "name": { "type": "string", "minLength": 3 },
          "description": { "type": "string" },
          "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 480 },
          "price": { "type": "number", "minimum": 0 }
        }
      },
      "CreateServiceRequest": {
        "type": "object",
        "required": ["name", "durationMinutes", "price"],
        "properties": {
          "name": { "type": "string", "minLength": 3 },
          "description": { "type": "string" },
          "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 480 },
          "price": { "type": "number", "minimum": 0 }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "limit": { "type": "integer", "minimum": 1 },
          "total": { "type": "integer", "minimum": 0 },
          "pages": { "type": "integer", "minimum": 0 }
        }
      },
      "HealthStatus": {
        "type": "object",
        "required": ["status", "service"],
        "properties": {
          "status": { "type": "string", "enum": ["ok", "degraded"] },
          "service": { "type": "string" },
          "dbConnected": { "type": "boolean" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["status", "code", "message"],
            "properties": {
              "status": { "type": "integer" },
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}

PORT=3000
SERVICE_NAME=serv365-api
# Compose env file mounted into app containers.
# Local default should be .env.local; CI can use .env.example.
APP_ENV_FILE=.env.example
FRONTEND_PORT=8080
APPOINTMENTS_SERVICE_PORT=3001
APPOINTMENTS_SERVICE_URL=
CUSTOMERS_SERVICE_PORT=3002
SERVICES_SERVICE_PORT=3003
PROFESSIONALS_SERVICE_PORT=3004

# Database provider: mongodb or postgres.
# If not set, the API resolves postgres when POSTGRES_URI/DATABASE_URL exists;
# otherwise it falls back to mongodb.
DATABASE_PROVIDER=mongodb

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/crm-booking-api
# When running apps in docker-compose and the database is exposed on the host,
# use host.docker.internal instead of 127.0.0.1 in .env.local.
# MONGODB_URI=mongodb://host.docker.internal:27017/crm-booking-api

# PostgreSQL
POSTGRES_URI=postgres://postgres:postgres@127.0.0.1:5432/crm_booking_api
# POSTGRES_URI=postgres://postgres:postgres@host.docker.internal:5432/crm_booking_api
# Railway usually exposes this as DATABASE_URL. It is used when POSTGRES_URI is not set.
# DATABASE_URL=postgresql://user:password@host:port/railway

SWAGGER_SERVER_URL=http://localhost:3000

# Static frontend directory served by the API.
# Defaults to apps/frontend/public.
FRONTEND_PUBLIC_DIR=

# Comma-separated list. Example:
# CORS_ORIGINS=https://your-frontend.com,http://localhost:5173
CORS_ORIGINS=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# API gateway security.
# disabled: keeps local/dev behavior open.
# bearer: requires Authorization: Bearer <token> for /api routes except public paths.
GATEWAY_AUTH_MODE=disabled
GATEWAY_BEARER_TOKENS=
# Comma-separated path prefixes. Defaults include /, /api/health and /api-docs.
GATEWAY_PUBLIC_PATHS=

# Internal service-to-service auth.
# When set, services require x-internal-token for /api routes except /api/health.
INTERNAL_SERVICE_TOKEN=
# Optional appointments-specific token sent by the gateway. Falls back to INTERNAL_SERVICE_TOKEN.
APPOINTMENTS_SERVICE_INTERNAL_TOKEN=
# Comma-separated public path prefixes for internal services. Defaults include /api/health.
INTERNAL_SERVICE_PUBLIC_PATHS=
DATABASE_CONNECT_RETRIES=10
DATABASE_CONNECT_RETRY_MS=3000
DEBUG_ENV=false

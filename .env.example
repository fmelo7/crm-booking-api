PORT=3000

# Database provider: mongodb or postgres.
# If not set, the API resolves postgres when POSTGRES_URI/DATABASE_URL exists;
# otherwise it falls back to mongodb.
DATABASE_PROVIDER=mongodb

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/crm-booking-api

# PostgreSQL
POSTGRES_URI=postgres://postgres:postgres@127.0.0.1:5432/crm_booking_api
# Railway usually exposes this as DATABASE_URL. It is used when POSTGRES_URI is not set.
# DATABASE_URL=postgresql://user:password@host:port/railway

SWAGGER_SERVER_URL=http://localhost:3000

# Static frontend directory served by the API.
# Defaults to apps/frontend/public.
FRONTEND_PUBLIC_DIR=

# Comma-separated list. Example:
# CORS_ORIGINS=https://your-frontend.com,http://localhost:5173
CORS_ORIGINS=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# API gateway security.
# disabled: keeps local/dev behavior open.
# bearer: requires Authorization: Bearer <token> for /api routes except public paths.
GATEWAY_AUTH_MODE=disabled
GATEWAY_BEARER_TOKENS=
# Comma-separated path prefixes. Defaults include /, /api/health and /api-docs.
GATEWAY_PUBLIC_PATHS=
DATABASE_CONNECT_RETRIES=10
DATABASE_CONNECT_RETRY_MS=3000
DEBUG_ENV=false
